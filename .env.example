# Email Service Configuration
# Choose one of the email providers below and set the required variables

# EMAIL_PROVIDER options: "nodemailer" (default), "gmail-api", "sendgrid"
EMAIL_PROVIDER=nodemailer

# ============================================
# NODEMAILER CONFIGURATION (Gmail App Password)
# ============================================
# 1. Enable 2-Factor Authentication on Gmail account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select Mail and your device
# 4. Copy the 16-character password Google provides
# 5. Set the variables below

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ============================================
# GMAIL API CONFIGURATION (Backend Team)
# ============================================
# For Gmail API with service account authentication
# Instructions: See BACKEND_EMAIL_INTEGRATION.md

# GMAIL_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
# GMAIL_SERVICE_ACCOUNT_KEY=/path/to/service-account-key.json
# Or provide the JSON key directly:
# GMAIL_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ============================================
# SENDGRID CONFIGURATION (Backend Team)
# ============================================
# For SendGrid email service
# Instructions: See BACKEND_EMAIL_INTEGRATION.md

# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxx
# SENDGRID_FROM_EMAIL=noreply@example.com

# ============================================
# Other Configuration
# ============================================
PING_MESSAGE=pong
